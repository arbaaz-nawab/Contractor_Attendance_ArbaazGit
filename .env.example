# Copy this file to .env.local and fill in real values.
# See SETUP_GUIDE.md for what each variable does and where to get it.
# Never commit .env.local — it's gitignored on purpose.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- App config (required) ---
DASHBOARD_PIN=
SESSION_SECRET=
CRON_SECRET=

# --- Manager PINs (optional — fallback if the managers table is empty) ---
MANAGER_PINS=
APPROVAL_PIN=

# --- Cloudflare R2 (optional — leave blank to skip photo uploads) ---
CF_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET=

# --- Resend / email (optional, currently dormant — see MEMORY.md) ---
RESEND_API_KEY=
RESEND_FROM=
